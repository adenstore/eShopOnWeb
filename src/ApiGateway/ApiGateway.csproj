<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Microsoft.eShopWeb.ApiGateway</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ocelot" />
    <!-- Basket is not proxied over HTTP: the gateway turns those REST calls into messages itself. -->
    <PackageReference Include="RabbitMQ.Client" />
    <!-- Where the basket read projection lives, so basket reads cost no queue round-trip. -->
    <PackageReference Include="StackExchange.Redis" />
  </ItemGroup>

  <ItemGroup>
    <!-- The message shapes and exchange/routing-key names BasketService publishes for its callers.
         They are in their own assembly precisely so the gateway can publish to it without
         compiling against the service's DbContext and consumers. -->
    <ProjectReference Include="..\..\BasketService\BasketService.Contracts\BasketService.Contracts.csproj" />
  </ItemGroup>

</Project>
