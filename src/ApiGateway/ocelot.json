        {
          "Host": "catalogservice",
          "Port": 8080
        }
      ]
    },
    {
      "UpstreamPathTemplate": "/api/basket/{everything}",
      "UpstreamHttpMethod": [ "GET", "POST", "PUT", "DELETE" ],
