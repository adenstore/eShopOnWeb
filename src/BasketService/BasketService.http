###############################################################################
# BasketService API
#
# Run the service first:  dotnet run --project src/BasketService
# Swagger UI:             http://localhost:5198/swagger
#
# Response chaining ({{request.response.body.$.id}}) is a VS Code REST Client
# feature and is NOT supported by Visual Studio's .http editor. In VS, run the
# requests in order and paste the ids into @basketId / @itemId by hand.
#
# Every request that reaches the database needs a real SQL Server. The default
# connection string is LocalDB, which does not exist on Linux — expect 500s
# there until BasketConnection points somewhere real. The validation cases at
# the bottom are rejected before any query runs, so those work regardless.
###############################################################################

@host = http://localhost:5198
@buyerId = demouser@microsoft.com
@anonymousId = 3fa85f64-5717-4562-b3fc-2c963f66afa6
@catalogItemId = 1
@otherCatalogItemId = 2


###############################################################################
# Happy path — the shopping flow, in order
###############################################################################

### Get or create the buyer's basket. Creates an empty one on first call,
### returns the same basket on every call after that.
# @name getOrCreate
POST {{host}}/api/baskets/{{buyerId}}

@basketId = {{getOrCreate.response.body.$.id}}


### Add an item. The caller supplies the price — this service never reads the
### catalog, which is what keeps its database independent.
# @name addItem
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": {{catalogItemId}},
  "unitPrice": 19.50,
  "quantity": 2
}

@itemId = {{addItem.response.body.$.items[0].id}}


### Add the same catalog item again. Should merge into the existing line and
### leave Items at length 1 with quantity 5, not append a second line.
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": {{catalogItemId}},
  "unitPrice": 19.50,
  "quantity": 3
}


### Add a different catalog item. Now Items should have 2 entries.
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": {{otherCatalogItemId}},
  "unitPrice": 8.00,
  "quantity": 1
}


### Total quantity across the basket, summed in SQL rather than in memory.
### Backs the header badge, so it runs on nearly every page render.
### After the three adds above: 5 + 1 = 6.
GET {{host}}/api/baskets/{{buyerId}}/items/count


### Change the quantity of a line already in the basket. Keyed by basket *item*
### id as a string — the shape IBasketService.SetQuantities already expects.
PUT {{host}}/api/baskets/{{basketId}}/items
Content-Type: application/json

{
  "quantities": {
    "{{itemId}}": 4
  }
}


### Setting a quantity to 0 drops the line entirely (RemoveEmptyItems).
PUT {{host}}/api/baskets/{{basketId}}/items
Content-Type: application/json

{
  "quantities": {
    "{{itemId}}": 0
  }
}


### Delete the basket. This is what checkout calls once the order exists.
### Expect 204.
DELETE {{host}}/api/baskets/{{basketId}}


###############################################################################
# Transfer — anonymous basket merging into a signed-in user at login
###############################################################################

### Create a basket against a cookie id, as an anonymous visitor would.
# @name anonBasket
POST {{host}}/api/baskets/{{anonymousId}}


### Put something in it.
POST {{host}}/api/baskets/{{anonymousId}}/items
Content-Type: application/json

{
  "catalogItemId": {{catalogItemId}},
  "unitPrice": 19.50,
  "quantity": 1
}


### Merge it onto the signed-in user and delete the anonymous one. Expect 204.
POST {{host}}/api/baskets/transfer
Content-Type: application/json

{
  "anonymousId": "{{anonymousId}}",
  "userName": "{{buyerId}}"
}


### The user's count should now include the transferred quantity.
GET {{host}}/api/baskets/{{buyerId}}/items/count


### The anonymous basket is gone, so this creates a fresh empty one —
### Items should come back as [].
POST {{host}}/api/baskets/{{anonymousId}}


### Transfer again with nothing to move. A no-op, still 204, which is what
### makes it safe to call on every sign-in.
POST {{host}}/api/baskets/transfer
Content-Type: application/json

{
  "anonymousId": "{{anonymousId}}",
  "userName": "{{buyerId}}"
}


###############################################################################
# Validation — rejected by [ApiController] before the action runs.
# These need no database and should return ProblemDetails 400s.
###############################################################################

### Quantity below 1. Expect 400, errors.Quantity.
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": {{catalogItemId}},
  "unitPrice": 19.50,
  "quantity": 0
}


### Negative price. Expect 400, errors.UnitPrice.
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": {{catalogItemId}},
  "unitPrice": -1.00,
  "quantity": 1
}


### Catalog item id below 1. Expect 400, errors.CatalogItemId.
POST {{host}}/api/baskets/{{buyerId}}/items
Content-Type: application/json

{
  "catalogItemId": 0,
  "unitPrice": 19.50,
  "quantity": 1
}


### Transfer with no userName. Expect 400, errors.UserName.
POST {{host}}/api/baskets/transfer
Content-Type: application/json

{
  "anonymousId": "{{anonymousId}}"
}


### Transfer with a blank anonymousId. [Required] rejects whitespace-only
### strings, so expect 400 rather than a no-op.
POST {{host}}/api/baskets/transfer
Content-Type: application/json

{
  "anonymousId": "   ",
  "userName": "{{buyerId}}"
}


### Malformed body. Expect 400 from the JSON reader.
POST {{host}}/api/baskets/transfer
Content-Type: application/json

{ "anonymousId": }


### A non-numeric basket id does not match the {basketId:int} constraint, so
### no action is reached. Expect 404 from routing, not 400.
DELETE {{host}}/api/baskets/not-an-int


###############################################################################
# Not found — these do hit the database
###############################################################################

### Set quantities on a basket that does not exist. Expect 404 (SetQuantities
### returns Result.NotFound rather than throwing).
PUT {{host}}/api/baskets/999999/items
Content-Type: application/json

{
  "quantities": {
    "1": 1
  }
}


### Delete a basket that does not exist. Expect 404 — the action translates the
### guard clause's ArgumentNullException so a retried checkout is not a 500.
DELETE {{host}}/api/baskets/999999


### Count for a buyer with no basket at all. Expect 200 with a count of 0,
### since the sum runs over an empty set rather than looking the basket up.
GET {{host}}/api/baskets/nobody@example.com/items/count


###############################################################################
# Through the Ocelot gateway (apigw branch) — step 4, not wired up yet
#
# ocelot.json routes /api/basket/{everything} to basketservice:8080 with a
# DownstreamPathTemplate of /api/{everything}. Since this controller lives at
# /api/baskets, that rewrite currently produces the doubled-up path below.
# Fixing it means setting DownstreamPathTemplate to /api/baskets/{everything}
# so that /api/basket/<buyerId> lands on /api/baskets/<buyerId>.
###############################################################################

### Gateway base URL per ocelot.json GlobalConfiguration.
@gateway = http://localhost:5278

### What the current gateway config would require.
# POST {{gateway}}/api/basket/baskets/{{buyerId}}

### What it should look like after the DownstreamPathTemplate fix.
# POST {{gateway}}/api/basket/{{buyerId}}
