<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>Microsoft.eShopWeb.BasketService</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="Ardalis.Result" />
    <PackageReference Include="Ardalis.Specification" />
    <PackageReference Include="Ardalis.Specification.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="RabbitMQ.Client" />
  </ItemGroup>

  <ItemGroup>
    <!-- The message shapes and topology names this service owns, in their own assembly so that a
         caller can publish to it without compiling against the DbContext behind it. -->
    <ProjectReference Include="..\BasketService.Contracts\BasketService.Contracts.csproj" />

    <!-- For OrderCreatedIntegrationEvent and the order-events exchange name. A subscriber
         referencing the publisher's contracts project is the same arrangement ApplicationCore
         already uses; copying the event shape instead would let the two drift silently, and
         nothing validates a message against a schema at runtime to catch it. -->
    <ProjectReference Include="..\..\OrderService\OrderService.Contracts\OrderService.Contracts.csproj" />
  </ItemGroup>

</Project>
